<resources>
    <!-- Le theme garde le meme nom en mode sombre, seules les couleurs values-night changent. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Couleur principale lue depuis values-night/colors.xml. -->
        <item name="colorPrimary">@color/colorPrimary</item>

        <!-- Couleur foncee lue depuis values-night/colors.xml. -->
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>

        <!-- Couleur d'accent lue depuis values-night/colors.xml. -->
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Fond sombre applique automatiquement en mode nuit. -->
        <item name="android:windowBackground">@color/backgroundColor</item>

        <!-- Texte principal adapte au fond sombre. -->
        <item name="android:textColorPrimary">@color/textColorPrimary</item>

        <!-- Texte secondaire adapte au fond sombre. -->
        <item name="android:textColorSecondary">@color/textColorSecondary</item>

        <!-- Style commun des boutons Material. -->
        <item name="materialButtonStyle">@style/Widget.SecureUIApp.MaterialButton</item>

        <!-- Style commun des champs Material. -->
        <item name="textInputStyle">@style/Widget.SecureUIApp.TextInputLayout</item>
    </style>

    <!-- Ancien nom conserve pour compatibilite. -->
    <style name="Theme.SecureUIApp" parent="AppTheme" />
</resources>
