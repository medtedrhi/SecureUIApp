<?xml version="1.0" encoding="utf-8"?>
<!-- Racine ConstraintLayout demandee pour organiser l'ecran principal. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:padding="20dp"
    tools:context=".MainActivity">

    <!-- ScrollView pour garder tous les elements accessibles sur les petits ecrans. -->
    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Conteneur vertical simple pour rendre le formulaire facile a lire. -->
        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Ligne du titre et de l'icone de reglages. -->
            <LinearLayout
                android:id="@+id/headerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Titre principal lu par TalkBack car il n'est pas sensible. -->
                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Formulaire Sécurisé"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- Icone de reglages avec description pour les utilisateurs TalkBack. -->
                <ImageView
                    android:id="@+id/imgSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Changer le mode clair ou sombre"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_manage" />
            </LinearLayout>

            <!-- Champ Material pour le nom d'utilisateur. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputUsernameLayout"
                style="@style/Widget.SecureUIApp.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:hint="Nom d'utilisateur">

                <!-- Zone de saisie du nom d'utilisateur. -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="Champ nom d'utilisateur"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Champ Material pour le mot de passe. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputPasswordLayout"
                style="@style/Widget.SecureUIApp.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Mot de passe">

                <!-- Mot de passe masque et exclu de TalkBack car il est sensible. -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="Champ mot de passe protégé"
                    android:importantForAccessibility="no"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Bouton de connexion avec libelle clair. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/Widget.SecureUIApp.MaterialButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Connexion" />

            <!-- Texte sensible visible a l'ecran mais non lu par TalkBack. -->
            <TextView
                android:id="@+id/txtSensitiveInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@color/cardBackground"
                android:focusable="true"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:text="Information sensible: 1234-5678-9012"
                android:textColor="@color/textColorPrimary"
                android:textSize="16sp" />

            <!-- Bouton vers la demonstration du mode clair et sombre. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemeDemo"
                style="@style/Widget.SecureUIApp.MaterialButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Démonstration des Thèmes" />

            <!-- Bouton vers la demonstration des animations. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnimationDemo"
                style="@style/Widget.SecureUIApp.MaterialButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Démonstration des Animations" />

            <!-- Bouton vers la demonstration de securite UX. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSecurityDemo"
                style="@style/Widget.SecureUIApp.MaterialButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Démonstration de Sécurité UX" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
