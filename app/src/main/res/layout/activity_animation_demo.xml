<?xml version="1.0" encoding="utf-8"?>
<!-- Racine ConstraintLayout pour la demonstration des animations. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/animationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:padding="20dp"
    tools:context=".AnimationDemoActivity">

    <!-- ScrollView pour garder les boutons accessibles. -->
    <ScrollView
        android:id="@+id/animationScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Conteneur vertical principal. -->
        <LinearLayout
            android:id="@+id/animationContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Titre de l'ecran. -->
            <TextView
                android:id="@+id/txtAnimationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Démonstration des Animations"
                android:textColor="@color/textColorPrimary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Carte qui montre le resultat des animations. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/demoCard"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardCornerRadius="8dp"
                app:cardElevation="3dp">

                <!-- Texte centre dans la carte de demonstration. -->
                <TextView
                    android:id="@+id/txtDemoCard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Carte de démonstration"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Liste verticale des boutons d'animation. -->
            <LinearLayout
                android:id="@+id/animationButtonList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <!-- Bouton pour l'animation de pulsation. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPulse"
                    style="@style/Widget.SecureUIApp.MaterialButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Animation de Pulsation" />

                <!-- Bouton pour l'animation de rebond. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBounce"
                    style="@style/Widget.SecureUIApp.MaterialButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Animation de Rebond" />

                <!-- Bouton pour l'animation d'apparition. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFadeIn"
                    style="@style/Widget.SecureUIApp.MaterialButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Animation d'Apparition" />

                <!-- Bouton pour l'animation d'entree. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnter"
                    style="@style/Widget.SecureUIApp.MaterialButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Animation d'Entrée" />

                <!-- Bouton pour l'animation combinee rotation, translation et scale. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCombined"
                    style="@style/Widget.SecureUIApp.MaterialButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Animation Combinée" />
            </LinearLayout>

            <!-- Bouton retour pour fermer cet ecran. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackAnimation"
                style="@style/Widget.SecureUIApp.MaterialButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Retour" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
